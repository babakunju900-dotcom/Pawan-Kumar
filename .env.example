# GEMINI_API_KEY: Required for Gemini AI Admin Assistant calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional External Metadata & Streaming Integrations (configured server-side)
YOUTUBE_API_KEY=""
TMDB_API_KEY=""
PAYMENT_GATEWAY_KEY=""
ADMIN_EMAIL=""
ADMIN_PASSCODE=""
